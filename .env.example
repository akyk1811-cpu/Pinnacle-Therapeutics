# Public site URL, added when the domain is purchased
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry delivery. Never commit real credentials.
CONTACT_NOTIFY_EMAIL=info@pinnacletherapeutics.in
CONTACT_NOTIFY_PHONE=+919821607700
CONTACT_FROM_EMAIL=Pinnacle Therapeutics <onboarding@resend.dev>
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional fallback if you already use a webhook-based notifier.
CONTACT_WEBHOOK_URL=

# Neon Postgres stores contact submissions. Keep this server-side only.
DATABASE_URL=
# A random, private value used to hash submitter IP addresses.
CONTACT_IP_SALT=
# Upstash Redis provides durable, distributed form rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
